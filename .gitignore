.env
__pycache__/
*.pyc
.venv/
venv/

# ビルド生成物。GitHub Actions が毎回作り直して Pages へ直接デプロイするため
# リポジトリには含めない（Pages の Source は "GitHub Actions" を選択すること）
docs/

# ⚠️ data/ は絶対に ignore しないこと。
# 価格履歴はこのサイトで唯一、後から取り戻せない資産で、
# リポジトリに書き戻されることではじめて蓄積される。
# ここに data/ を足した瞬間、毎日「初回観測」からやり直しになり、
# 変更ログが永久に空のままのサイトになる。
